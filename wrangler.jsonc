{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "baby-sleep",
  "compatibility_date": "2026-09-11",
  "workers_dev": false,
  "routes": [{ "pattern": "sleep.marek.work", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
  },
}
